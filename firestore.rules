rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Messages — only the owner can CRUD
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Recipients — only the owner can CRUD
      match /recipients/{recipientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Trusted contacts — only the owner can CRUD
      match /trustedContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Vault items — only the owner can CRUD
      match /vaultItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Settings (trigger, etc.) — only the owner
      match /settings/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
